<Window x:Class="ShopWalletApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shop Wallet Manager" Height="850" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">

    <Window.Resources>
        <Style x:Key="DailyRemainingCell" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DailyAlertLevel}" Value="Warning">
                    <Setter Property="Background" Value="#FFF3CD"/><Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DailyAlertLevel}" Value="Critical">
                    <Setter Property="Background" Value="#F8D7DA"/><Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WeeklyRemainingCell" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding WeeklyAlertLevel}" Value="Warning">
                    <Setter Property="Background" Value="#FFF3CD"/><Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding WeeklyAlertLevel}" Value="Critical">
                    <Setter Property="Background" Value="#F8D7DA"/><Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonthlyRemainingCell" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding MonthlyAlertLevel}" Value="Warning">
                    <Setter Property="Background" Value="#FFF3CD"/><Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding MonthlyAlertLevel}" Value="Critical">
                    <Setter Property="Background" Value="#F8D7DA"/><Setter Property="Foreground" Value="Black"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Styles -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#007BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0056b3"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <!-- Dashboard Card Style -->
        <Style x:Key="DashboardCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,15,15"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Gray" Direction="270" ShadowDepth="2" BlurRadius="5" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DataGrid Group Header Style -->
        <Style TargetType="GroupItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupItem">
                        <StackPanel>
                            <Border Background="#E9ECEF" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1" Padding="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#495057"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Items[0].DailyTotal, StringFormat='Daily Total: {0:C}'}" FontWeight="Bold" Foreground="#28A745"/>
                                </Grid>
                            </Border>
                            <ItemsPresenter/>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <TabControl Background="Transparent" BorderThickness="0">

            <!-- TAB 0: DASHBOARD -->
            <TabItem Header="📊 Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="Shop Overview" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>

                        <!-- Summary Cards -->
                        <WrapPanel>
                            <Border Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="Today's Deposits" Foreground="#666" FontSize="12"/>
                                    <TextBlock x:Name="lblDashDailyDeposit" Text="0.00 EGP" FontSize="20" FontWeight="Bold" Foreground="#28A745"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="Today's Withdrawals" Foreground="#666" FontSize="12"/>
                                    <TextBlock x:Name="lblDashDailyWithdraw" Text="0.00 EGP" FontSize="20" FontWeight="Bold" Foreground="#DC3545"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="Monthly Deposits" Foreground="#666" FontSize="12"/>
                                    <TextBlock x:Name="lblDashMonthlyDeposit" Text="0.00 EGP" FontSize="20" FontWeight="Bold" Foreground="#28A745"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="Monthly Withdrawals" Foreground="#666" FontSize="12"/>
                                    <TextBlock x:Name="lblDashMonthlyWithdraw" Text="0.00 EGP" FontSize="20" FontWeight="Bold" Foreground="#DC3545"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="Transactions Today" Foreground="#666" FontSize="12"/>
                                    <TextBlock x:Name="lblDashDailyCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#007BFF"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource DashboardCard}">
                                <StackPanel>
                                    <TextBlock Text="Active Master Numbers" Foreground="#666" FontSize="12"/>
                                    <TextBlock x:Name="lblDashMasterCount" Text="0" FontSize="20" FontWeight="Bold" Foreground="#6F42C1"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <TextBlock Text="Master Numbers Status (Daily &amp; Monthly Limits)" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,20,0,10"/>

                        <!-- Master Numbers Dashboard Grid -->
                        <DataGrid x:Name="GridDashboardMasterNumbers" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                                  IsReadOnly="True" HeadersVisibility="Column" Height="300">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Master Number" Binding="{Binding PhoneNumber}" Width="130"/>

                                <!-- Daily Section -->
                                <DataGridTextColumn Header="Daily Total Transactions" Binding="{Binding DailyTotalTransactions, StringFormat=C}" Width="110"/>
                                <DataGridTextColumn Header="Daily Limit" Binding="{Binding DailyLimit, StringFormat=C}" Width="100"/>
                                <DataGridTextColumn Header="Daily Remaining" Binding="{Binding DailyRemaining, StringFormat=C}" Width="110" CellStyle="{StaticResource DailyRemainingCell}"/>
                                <DataGridTemplateColumn Header="Daily Usage" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding DailyProgress}" Maximum="100" Height="15" Foreground="#007BFF" Background="#E9ECEF"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Monthly Section -->
                                <DataGridTextColumn Header="Monthly Total Transactions" Binding="{Binding MonthlyTotalTransactions, StringFormat=C}" Width="110"/>
                                <DataGridTextColumn Header="Monthly Limit" Binding="{Binding MonthlyLimit, StringFormat=C}" Width="100"/>
                                <DataGridTextColumn Header="Monthly Remaining" Binding="{Binding MonthlyRemaining, StringFormat=C}" Width="110" CellStyle="{StaticResource MonthlyRemainingCell}"/>
                                <DataGridTemplateColumn Header="Monthly Usage" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding MonthlyProgress}" Maximum="100" Height="15" Foreground="#6F42C1" Background="#E9ECEF"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Low Limit" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="●" FontSize="20" HorizontalAlignment="Center">
                                                <TextBlock.ToolTip><StackPanel>
                                                    <TextBlock Text="{Binding LowLimitLevel}"/>
                                                    <TextBlock Text="{Binding DailyRemaining, StringFormat='Daily Remaining: {0:N2} EGP'}"/>
                                                    <TextBlock Text="{Binding WeeklyRemaining, StringFormat='Weekly Remaining: {0:N2} EGP'}"/>
                                                    <TextBlock Text="{Binding MonthlyRemaining, StringFormat='Monthly Remaining: {0:N2} EGP'}"/>
                                                </StackPanel></TextBlock.ToolTip>
                                                <TextBlock.Style><Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="Green"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LowLimitLevel}" Value="Warning"><Setter Property="Foreground" Value="#D6A000"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding LowLimitLevel}" Value="Critical"><Setter Property="Foreground" Value="Red"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style></TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 1: DEPOSIT -->
            <TabItem Header="Deposit">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Summary Section -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#E3F2FD" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Today's Total Deposits: " FontWeight="Bold" Foreground="#0D47A1"/>
                            <TextBlock x:Name="lblDailyDepositTotal" Text="0.00" FontWeight="Bold" Foreground="#0D47A1" Margin="0,0,20,0"/>
                            <TextBlock Text="This Month's Total Deposits: " FontWeight="Bold" Foreground="#0D47A1"/>
                            <TextBlock x:Name="lblMonthlyDepositTotal" Text="0.00" FontWeight="Bold" Foreground="#0D47A1"/>
                        </StackPanel>
                    </Border>

                    <!-- Input Section -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                        <Label Content="Customer Phone Number (11 digits):"/>
                        <TextBox x:Name="txtDepositPhone"/>
                        <Label Content="Amount:"/>
                        <TextBox x:Name="txtDepositAmount"/>
                        <Label Content="Source Number (Master Number)"/>
                        <ComboBox x:Name="cmbDepositSourceNumbers" Margin="0,5,0,10" Padding="5" DisplayMemberPath="PhoneNumber" SelectedValuePath="PhoneNumber"/>
                        <Button Content="Apply Deposit" Click="BtnDeposit_Click" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- DataGrid Section with Grouping -->
                    <DataGrid Grid.Row="1" Grid.Column="1" x:Name="GridDeposits" AutoGenerateColumns="False" 
                              CanUserAddRows="False" Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                              IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.GroupStyle><GroupStyle /></DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Phone Number" Binding="{Binding PhoneNumber}" Width="120"/>
                            <DataGridTextColumn Header="Source Phone" Binding="{Binding SourcePhone}" Width="120"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="100"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding TransactionDate, StringFormat=HH:mm}" Width="80"/>
                            <DataGridTemplateColumn Header="Actions" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Click="BtnEditDeposit_Click" Background="#FFC107" Foreground="Black" Margin="0,0,5,0" Width="50" Tag="{Binding Transaction}"/>
                                            <Button Content="Delete" Click="BtnDeleteDeposit_Click" Background="#DC3545" Width="60" Tag="{Binding Transaction}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination Controls -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Previous" Click="BtnPrevDeposit_Click" Width="80" Margin="0,0,10,0"/>
                        <TextBlock x:Name="lblDepositPageInfo" Text="Page 1 of 1" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                        <Button Content="Next" Click="BtnNextDeposit_Click" Width="80"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 2: WITHDRAW -->
            <TabItem Header="Withdraw">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Summary Section -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#FFF3E0" CornerRadius="5" Padding="10" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Today's Total Withdrawals: " FontWeight="Bold" Foreground="#E65100"/>
                            <TextBlock x:Name="lblDailyWithdrawTotal" Text="0.00" FontWeight="Bold" Foreground="#E65100" Margin="0,0,20,0"/>
                            <TextBlock Text="This Month's Total Withdrawals: " FontWeight="Bold" Foreground="#E65100"/>
                            <TextBlock x:Name="lblMonthlyWithdrawTotal" Text="0.00" FontWeight="Bold" Foreground="#E65100"/>
                        </StackPanel>
                    </Border>

                    <!-- Input Section -->
                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,20,0">
                        <Label Content="Customer Phone Number (11 digits):"/>
                        <TextBox x:Name="txtWithdrawPhone"/>
                        <Label Content="Amount:"/>
                        <TextBox x:Name="txtWithdrawAmount"/>
                        <Label Content="Source Number (From Master List):"/>
                        <ComboBox x:Name="cmbSourceNumbers" Margin="0,5,0,10" Padding="5" DisplayMemberPath="PhoneNumber" SelectedValuePath="PhoneNumber"/>
                        <Button Content="Apply Withdraw" Click="BtnWithdraw_Click" Margin="0,10,0,0"/>
                    </StackPanel>

                    <!-- DataGrid Section with Grouping -->
                    <DataGrid Grid.Row="1" Grid.Column="1" x:Name="GridWithdraws" AutoGenerateColumns="False" 
                              CanUserAddRows="False" Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                              IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.GroupStyle><GroupStyle /></DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Customer Phone" Binding="{Binding PhoneNumber}" Width="120"/>
                            <DataGridTextColumn Header="Source Phone" Binding="{Binding SourcePhone}" Width="120"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat=C}" Width="100"/>
                            <DataGridTextColumn Header="Time" Binding="{Binding TransactionDate, StringFormat=HH:mm}" Width="80"/>
                            <DataGridTemplateColumn Header="Actions" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Click="BtnEditWithdraw_Click" Background="#FFC107" Foreground="Black" Margin="0,0,5,0" Width="50" Tag="{Binding Transaction}"/>
                                            <Button Content="Delete" Click="BtnDeleteWithdraw_Click" Background="#DC3545" Width="60" Tag="{Binding Transaction}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Pagination Controls -->
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button Content="Previous" Click="BtnPrevWithdraw_Click" Width="80" Margin="0,0,10,0"/>
                        <TextBlock x:Name="lblWithdrawPageInfo" Text="Page 1 of 1" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,10,0"/>
                        <Button Content="Next" Click="BtnNextWithdraw_Click" Width="80"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 3: MASTER NUMBERS -->
            <TabItem Header="Master Numbers">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Input Section -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,0">
                        <Label Content="Master Phone Number (11 digits):"/>
                        <TextBox x:Name="txtMasterPhone"/>
                        <Label Content="Daily Limit Amount:"/>
                        <TextBox x:Name="txtDailyLimit"/>
                        <Label Content="Weekly Limit Amount:"/>
                        <TextBox x:Name="txtWeeklyLimit"/>
                        <Label Content="Monthly Limit Amount:"/>
                        <TextBox x:Name="txtMonthlyLimit"/>
                        <Button Content="Save Master Number" Click="BtnSaveMaster_Click" Margin="0,10,0,0"/>
                        <Label Content="Alert Threshold Amount (EGP)" Margin="0,20,0,0"/>
                        <TextBox x:Name="txtAlertThreshold"/>
                        <Button Content="Save Alert Threshold" Click="BtnSaveAlertThreshold_Click"/>
                    </StackPanel>

                    <!-- DataGrid Section for Status -->
                    <DataGrid Grid.Row="0" Grid.Column="1" x:Name="GridMasterNumbers" AutoGenerateColumns="False" 
                              CanUserAddRows="False" Background="White" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Phone Number" Binding="{Binding PhoneNumber}" Width="120"/>
                            <DataGridTextColumn Header="Daily Total Transactions" Binding="{Binding DailyTotalTransactions, StringFormat=C}" Width="150"/>
                            <DataGridTextColumn Header="Daily Limit" Binding="{Binding DailyLimit, StringFormat=C}" Width="90"/>
                            <DataGridTextColumn Header="Daily Remaining" Binding="{Binding DailyRemaining, StringFormat=C}" Width="100" CellStyle="{StaticResource DailyRemainingCell}"/>
                            <DataGridTextColumn Header="Weekly Total Transactions" Binding="{Binding WeeklyTotalTransactions, StringFormat=C}" Width="150"/>
                            <DataGridTextColumn Header="Weekly Limit" Binding="{Binding WeeklyLimit, StringFormat=C}" Width="90"/>
                            <DataGridTextColumn Header="Weekly Remaining" Binding="{Binding WeeklyRemaining, StringFormat=C}" Width="100" CellStyle="{StaticResource WeeklyRemainingCell}"/>
                            <DataGridTextColumn Header="Monthly Total Transactions" Binding="{Binding MonthlyTotalTransactions, StringFormat=C}" Width="150"/>
                            <DataGridTextColumn Header="Monthly Limit" Binding="{Binding MonthlyLimit, StringFormat=C}" Width="90"/>
                            <DataGridTextColumn Header="Monthly Remaining" Binding="{Binding MonthlyRemaining, StringFormat=C}" Width="100" CellStyle="{StaticResource MonthlyRemainingCell}"/>
                            <DataGridTemplateColumn Header="Actions" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Click="BtnEditMaster_Click" Background="#FFC107" Foreground="Black" Margin="0,0,5,0" Width="50" Tag="{Binding}"/>
                                            <Button Content="Delete" Click="BtnDeleteMaster_Click" Background="#DC3545" Width="60" Tag="{Binding}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>