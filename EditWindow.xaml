<Window x:Class="ShopWalletApp.EditWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Edit amount" Width="360" SizeToContent="Height"
 ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <StackPanel Margin="16">
  <TextBlock Text="New amount" Margin="0,0,0,6"/>
  <TextBox x:Name="ValueBox"/>
  <TextBlock x:Name="ErrorText" Foreground="Red" Margin="0,6,0,0"/>
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
   <Button Content="Cancel" IsCancel="True" MinWidth="75" Margin="0,0,8,0"/>
   <Button Content="Save" IsDefault="True" MinWidth="75" Click="Save_Click"/>
  </StackPanel>
 </StackPanel>
</Window>
